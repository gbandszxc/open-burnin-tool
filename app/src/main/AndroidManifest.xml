<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务：煲机播放需要常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 仅「检查更新」时匿名访问 GitHub 公开发布页，无需账号与 token；其余功能全程离线 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 仅用于把已下载到应用缓存的更新包交给系统安装器，应用自身不静默安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".BurnInApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BurnIn">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 煲机前台服务：mediaPlayback 类型，只负责保活与通知 -->
        <service
            android:name=".playback.BurnInService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 更新包安装：仅暴露缓存目录下的 updates/ 子目录给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
